# syntax=docker/dockerfile:1
# Wayland HUD — experimental. Prefer bare-metal overlay on the workstation.
# Needs host Wayland socket (see docker-compose profile "hud").

FROM archlinux:base

RUN pacman -Syu --noconfirm \
      gtk4 \
      gtk4-layer-shell \
      python \
      python-gobject \
      python-pip \
      gobject-introspection \
    && pacman -Scc --noconfirm

ENV QUESTS_ROOT=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/overlay/_vendor

WORKDIR /app
COPY overlay ./overlay
RUN pip install --no-cache-dir --target /app/overlay/_vendor pywayland \
    || true

# No server Python package needed — overlay talks HTTP to QUESTS_API.
CMD ["python", "-m", "overlay"]
