# Copy to `.env` in the project root (already gitignored).
# Bot and CLI load it automatically — no need for `export`.

# Telegram
QUESTS_TG_TOKEN=
QUESTS_TG_USER_IDS=
# QUESTS_TG_PROXY=http://127.0.0.1:12334

# Unread-mail emit_pool pipeline (scripts/pipelines/email_unread — the
# script itself lives in the "Почта" template's emit_pool_command, not a
# file on disk; only credentials belong out here). See note=6.
# MAIL_HOST=mail.refcool.net
# MAIL_USER=
# MAIL_PASSWORD=

# --- Accounts ---
# auto (default): auth turns on as soon as an account exists.
# on: require auth (server refuses to start with no accounts).
# off: no auth — allowed only on a loopback bind.
# QUESTS_AUTH=auto
# Mark the session cookie Secure. Set to 1 when served over HTTPS.
# QUESTS_SECURE_COOKIES=0
#
# Bootstrap (on the host holding quests.db):
#   quests-server useradd <username>          # prompts for a password
#   quests-server token add <name>            # token for a headless client
# Docker: docker compose exec api quests-server useradd <username>
#
# Bearer token for headless clients (CLI, HUD, bot, MCP). Never commit a real one.
# QUESTS_API_TOKEN=

# Quests API (default http://127.0.0.1:8765)
# Local: leave default. Remote HUD/bot: point at the server host.
# QUESTS_API=http://127.0.0.1:8765
# QUESTS_API_TIMEOUT=3

# Docker Compose (deploy/docker): publish ports
# QUESTS_PUBLISH_PORT=8765
# QUESTS_HTTP_PORT=8080
# Prebuilt images from GHCR (CI on main). Local default: quests-*:local + build.
# QUESTS_API_IMAGE=ghcr.io/<owner>/quests-api:main
# QUESTS_BOT_IMAGE=ghcr.io/<owner>/quests-bot:main

# Server bind (for remote clients set HOST to 0.0.0.0)
# QUESTS_HOST=127.0.0.1
# QUESTS_PORT=8765
# Extra CORS origins for Vite / remote SPA (comma-separated)
# QUESTS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Overlay: journal URL on quest title click (optional).
# If unset and QUESTS_API is remote → opens that host (SPA on same API).
# Local: probes Vite :5173 then :8765. Set explicitly if UI is on another port (:8080).
# QUESTS_WEB_URL=http://SERVER_IP:8080

# LLM for /new-llm and `quests llm-add` (default: Groq)
# QUESTS_LLM_PROVIDER=groq
GROQ_API_KEY=
# QUESTS_LLM_MODEL=openai/gpt-oss-20b
# QUESTS_TZ=Europe/Moscow
# Groq's Cloudflare front blocks some regions/networks outright (403).
# Reuses QUESTS_TG_PROXY automatically if set; override explicitly with:
# QUESTS_LLM_PROXY=http://127.0.0.1:12334

# Optional Cursor Agent API:
# QUESTS_LLM_PROVIDER=cursor
# CURSOR_API_KEY=
# QUESTS_LLM_MODEL=composer-2.5

# Optional Ollama fallback:
# QUESTS_LLM_PROVIDER=ollama
# QUESTS_LLM_BASE=http://127.0.0.1:11434
# QUESTS_LLM_MODEL=qwen2.5:7b

# Voice STT (faster-whisper) for TG voice/audio → /new-llm
# small | medium | large  (large → large-v3). Weak CPU: keep small.
# QUESTS_WHISPER_MODEL=small
# QUESTS_WHISPER_DEVICE=cpu
# QUESTS_WHISPER_COMPUTE=int8
# QUESTS_WHISPER_LANGUAGE=ru

# --- Attachments (WebDAV + ClamAV) ---
# Bytes live on the already-running WebDAV instance, not in Quests.
# Credentials stay on the server; clients download through the API proxy.
# QUESTS_WEBDAV_URL=http://192.168.1.11:8082
# QUESTS_WEBDAV_USER=quests
# QUESTS_WEBDAV_PASS=
# clamd address. In Docker Compose this defaults to clamav:3310.
# Empty = uploads refused (503) rather than stored unscanned.
# QUESTS_CLAMAV_ADDR=127.0.0.1:3310
# QUESTS_MAX_UPLOAD_MB=25
