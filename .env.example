# Copy to `.env` in the project root (already gitignored).
# Bot and CLI load it automatically — no need for `export`.

# Telegram
QUESTS_TG_TOKEN=
QUESTS_TG_USER_IDS=
# QUESTS_TG_PROXY=http://127.0.0.1:12334

# Quests API (default http://127.0.0.1:8765)
# Local: leave default. Remote HUD/bot: point at the server host.
# QUESTS_API=http://127.0.0.1:8765
# QUESTS_API_TIMEOUT=3

# Docker Compose (deploy/docker): publish ports
# QUESTS_PUBLISH_PORT=8765
# QUESTS_HTTP_PORT=8080
# Prebuilt images from GHCR (CI on main). Local default: quests-*:local + build.
# QUESTS_API_IMAGE=ghcr.io/<owner>/quests-api:main
# QUESTS_BOT_IMAGE=ghcr.io/<owner>/quests-bot:main

# Server bind (for remote clients set HOST to 0.0.0.0)
# QUESTS_HOST=127.0.0.1
# QUESTS_PORT=8765
# Extra CORS origins for Vite / remote SPA (comma-separated)
# QUESTS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Overlay: journal URL on quest title click (optional).
# If unset and QUESTS_API is remote → opens that host (SPA on same API).
# Local: probes Vite :5173 then :8765. Set explicitly if UI is on another port (:8080).
# QUESTS_WEB_URL=http://SERVER_IP:8080

# LLM for /new-llm and `quests llm-add` (default: Groq)
# QUESTS_LLM_PROVIDER=groq
GROQ_API_KEY=
# QUESTS_LLM_MODEL=llama-3.3-70b-versatile
# QUESTS_TZ=Europe/Moscow

# Optional Cursor Agent API:
# QUESTS_LLM_PROVIDER=cursor
# CURSOR_API_KEY=
# QUESTS_LLM_MODEL=composer-2.5

# Optional Ollama fallback:
# QUESTS_LLM_PROVIDER=ollama
# QUESTS_LLM_BASE=http://127.0.0.1:11434
# QUESTS_LLM_MODEL=qwen2.5:7b

# Voice STT (faster-whisper) for TG voice/audio → /new-llm
# small | medium | large  (large → large-v3). Weak CPU: keep small.
# QUESTS_WHISPER_MODEL=small
# QUESTS_WHISPER_DEVICE=cpu
# QUESTS_WHISPER_COMPUTE=int8
# QUESTS_WHISPER_LANGUAGE=ru
