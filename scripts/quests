#!/usr/bin/env bash
# Run the Quests CLI binary (build if missing).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="${QUESTS_CLI_BIN:-$ROOT/go/bin/quests}"
export QUESTS_ROOT="${QUESTS_ROOT:-$ROOT}"
if [[ ! -x "$BIN" ]]; then
  echo "quests: binary missing, building…" >&2
  "$ROOT/scripts/build-cli.sh"
fi
exec "$BIN" "$@"
